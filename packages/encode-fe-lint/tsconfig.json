{
  "compilerOptions": {
    "outDir": "./lib",
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "removeComments": true,
    "resolveJsonModule": true,
    "declaration": true,
    "downlevelIteration": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
