{
  "name": "encode-eslint-plugin",
  "version": "0.0.38",
  "description": "自定义eslint插件",
  "scripts": {
    "test": "jest",
    "build": "tsup index.js --format cjs,esm --dts --clean --out-dir dist",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "encode",
    "eslint",
    "eslint-plugin"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "author": "qingfeng",
  "homepage": "https://github.com/qingFeng818/encode-spec-engine#readme",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingFeng818/encode-spec-engine.git"
  },
  "bugs": {
    "url": "https://github.com/qingFeng818/encode-spec-engine/issues"
  },
  "dependencies": {
    "fs-extra": "^11.3.0",
    "require-all": "^3.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "tsup": "^8.4.0"
  },
  "gitHead": "690d6c4b65c01572acc4b21ee155a540beb5fe35"
}