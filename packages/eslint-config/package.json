{
  "name": "encode-eslint-config",
  "version": "0.0.38",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "description": " JavaScript TypeScript Node 规范",
  "keywords": [
    "encode",
    "javaScript",
    "typescript",
    "node",
    "lint"
  ],
  "scripts": {
    "lint": "eslint ./",
    "test": "mocha ./__tests__/*.test.js --timeout 5000",
    "print-config": "eslint --print-config ./index.js > ./print-config.json",
    "build": "tsup index.js --format cjs,esm --dts --clean --out-dir dist",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "rules",
    "essential",
    "flat.js"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./flat": "./flat.js",
    "./flat.js": "./flat.js",
    "./typescript": "./typescript/index.js",
    "./react": "./react.js",
    "./vue": "./vue.js"
  },
  "author": "mr_du",
  "homepage": "https://github.com/qingFeng818/encode-spec-engine#readme",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingFeng818/encode-spec-engine.git"
  },
  "bugs": {
    "url": "https://github.com/qingFeng818/encode-spec-engine/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.2",
    "eslint-config-egg": "^14.0.0",
    "eslint-import-resolver-typescript": "^3.8.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-jsx-plus": "^0.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-vue": "^9.32.0",
    "lodash": "^4.17.21",
    "mocha": "^11.1.0",
    "typescript": "^5.9.2",
    "vue-eslint-parser": "^10.1.1",
    "tsup": "^8.4.0"
  },
  "dependencies": {
    "eslint-plugin-n": "^17.17.0"
  },
  "gitHead": "690d6c4b65c01572acc4b21ee155a540beb5fe35"
}